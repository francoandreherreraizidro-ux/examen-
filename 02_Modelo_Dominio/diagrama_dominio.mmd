classDiagram
    direction TB

    class Producto {
        +Identificador id
        +Texto codigoInterno
        +Texto nombre
        +Texto descripcion
        +Codigo unidadComercial
        +EstadoProducto estado
    }

    class Almacen {
        +Identificador id
        +Texto codigo
        +Texto nombre
        +EstadoAlmacen estado
    }

    class MovimientoInventario {
        +Identificador id
        +TipoMovimiento tipo
        +Cantidad cantidad
        +Codigo unidad
        +FechaHora fechaHoraEfectiva
        +FechaHora fechaHoraRegistro
        +Referencia referenciaOrigen
    }

    class Proveedor {
        +Identificador id
        +Texto nombreORazonSocial
        +Texto identificadorComercial
        +DatosContacto datosContacto
        +EstadoTercero estado
    }

    class Cliente {
        +Identificador id
        +Texto nombreORazonSocial
        +Texto identificadorComercial
        +DatosContacto datosContacto
        +EstadoTercero estado
    }

    class Venta {
        +Identificador id
        +FechaHora fechaHora
        +EstadoVenta estado
        +Codigo moneda
        +Importe total
        +Referencia referenciaOrigen
    }

    class DetalleVenta {
        +Identificador id
        +Entero numeroLinea
        +Cantidad cantidad
        +Importe precioUnitario
        +Importe descuento
        +Importe importeLinea
        +Texto descripcionAlMomento
    }

    class ComprobanteElectronico {
        +Identificador id
        +Codigo tipoDocumento
        +Texto identificadorDocumento
        +FechaHora fechaEmision
        +EstadoEmision estadoEmision
        +Texto referenciaExterna
        +Texto huellaDocumento
    }

    class Categoria {
        <<opcional>>
        +Identificador id
        +Texto nombre
        +Texto descripcion
    }

    class Lote {
        <<condicional>>
        +Identificador id
        +Texto codigoLote
        +Fecha fechaVencimiento
    }

    class Recepcion {
        <<opcional>>
        +Identificador id
        +FechaHora fechaHora
        +EstadoRecepcion estado
    }

    class DetalleRecepcion {
        <<opcional>>
        +Identificador id
        +Cantidad cantidad
        +Importe costoUnitario
    }

    class Usuario {
        <<opcional>>
        +Identificador id
        +Texto nombreVisible
        +EstadoUsuario estado
    }

    %% Una categoría es opcional; se incorpora solo si se confirma clasificación de productos.
    Categoria "0..1" --> "0..*" Producto : clasifica

    %% El registro histórico requiere relacionar producto y almacén con cada movimiento.
    Producto "1" <-- "0..*" MovimientoInventario : afecta a
    Almacen "1" <-- "0..*" MovimientoInventario : registrado en

    %% Las multiplicidades de detalle aplican a ventas confirmadas.
    Cliente "0..1" <-- "0..*" Venta : cliente identificado
    Venta "1" *-- "1..*" DetalleVenta : contiene al confirmar
    Producto "1" <-- "0..*" DetalleVenta : vendido en

    %% El comprobante mantiene ciclo propio; cero no implica emisión aceptada.
    Venta "0..1" <-- "0..*" ComprobanteElectronico : origen comercial
    Venta "0..1" <-- "0..*" MovimientoInventario : origen de salida

    %% Extensiones sujetas a confirmación del proceso de abastecimiento y lotes.
    Proveedor "0..1" <-- "0..*" Recepcion : proveedor si aplica
    Almacen "1" <-- "0..*" Recepcion : destino
    Recepcion "1" *-- "1..*" DetalleRecepcion : contiene al confirmar
    Producto "1" <-- "0..*" DetalleRecepcion : recibido
    Recepcion "0..1" <-- "0..*" MovimientoInventario : origen de ingreso
    Producto "1" *-- "0..*" Lote : identifica partidas
    Lote "0..1" <-- "0..*" MovimientoInventario : trazado por lote

    %% La atribución a una persona depende de la política de auditoría pendiente.
    Usuario "0..1" <-- "0..*" Venta : registrado por
    Usuario "0..1" <-- "0..*" MovimientoInventario : registrado por
    Usuario "0..1" <-- "0..*" Recepcion : registrado por
