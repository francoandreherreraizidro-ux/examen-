@startuml DiagramaDominioSistemaComercial
title Modelo conceptual de dominio - Sistema comercial
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
left to right direction

note top
  Multiplicidades conceptuales sujetas a las decisiones pendientes
  de modelo_dominio.md. Los elementos con <<opcional>> o
  <<condicional>> no forman parte del nucleo confirmado.
  Los atributos son conceptuales; las asociaciones expresan referencias.
end note

package "Catalogo" {
  class Producto {
    +id: Identificador
    +codigoInterno: Texto
    +nombre: Texto
    +descripcion: Texto
    +unidadComercial: Codigo
    +estado: EstadoProducto
  }

  class Categoria <<opcional>> {
    +id: Identificador
    +nombre: Texto
    +descripcion: Texto
  }

  class Lote <<condicional>> {
    +id: Identificador
    +codigoLote: Texto
    +fechaVencimiento: Fecha
  }
}

package "Inventario" {
  class Almacen {
    +id: Identificador
    +codigo: Texto
    +nombre: Texto
    +estado: EstadoAlmacen
  }

  class MovimientoInventario {
    +id: Identificador
    +tipo: TipoMovimiento
    +cantidad: Cantidad
    +unidad: Codigo
    +fechaHoraEfectiva: FechaHora
    +fechaHoraRegistro: FechaHora
    +referenciaOrigen: Referencia
  }
}

package "Terceros" {
  class Proveedor {
    +id: Identificador
    +nombreORazonSocial: Texto
    +identificadorComercial: Texto
    +datosContacto: DatosContacto
    +estado: EstadoTercero
  }

  class Cliente {
    +id: Identificador
    +nombreORazonSocial: Texto
    +identificadorComercial: Texto
    +datosContacto: DatosContacto
    +estado: EstadoTercero
  }
}

package "Ventas" {
  class Venta {
    +id: Identificador
    +fechaHora: FechaHora
    +estado: EstadoVenta
    +moneda: Codigo
    +total: Importe
    +referenciaOrigen: Referencia
  }

  class DetalleVenta {
    +id: Identificador
    +numeroLinea: Entero
    +cantidad: Cantidad
    +precioUnitario: Importe
    +descuento: Importe
    +importeLinea: Importe
    +descripcionAlMomento: Texto
  }
}

package "Comprobantes" {
  class ComprobanteElectronico {
    +id: Identificador
    +tipoDocumento: Codigo
    +identificadorDocumento: Texto
    +fechaEmision: FechaHora
    +estadoEmision: EstadoEmision
    +referenciaExterna: Texto
    +huellaDocumento: Texto
  }
}

package "Abastecimiento opcional" {
  class Recepcion <<opcional>> {
    +id: Identificador
    +fechaHora: FechaHora
    +estado: EstadoRecepcion
  }

  class DetalleRecepcion <<opcional>> {
    +id: Identificador
    +cantidad: Cantidad
    +costoUnitario: Importe
  }
}

package "Auditoria opcional" {
  class Usuario <<opcional>> {
    +id: Identificador
    +nombreVisible: Texto
    +estado: EstadoUsuario
  }
}

Categoria "0..1" --> "0..*" Producto : clasifica
Producto "1" <-- "0..*" MovimientoInventario : afecta a
Almacen "1" <-- "0..*" MovimientoInventario : registrado en
Cliente "0..1" <-- "0..*" Venta : cliente identificado
Venta "1" *-- "1..*" DetalleVenta : contiene al confirmar
Producto "1" <-- "0..*" DetalleVenta : vendido en
Venta "0..1" <-- "0..*" ComprobanteElectronico : origen comercial
Venta "0..1" <-- "0..*" MovimientoInventario : origen de salida

Proveedor "0..1" <-- "0..*" Recepcion : proveedor si aplica
Almacen "1" <-- "0..*" Recepcion : destino
Recepcion "1" *-- "1..*" DetalleRecepcion : contiene al confirmar
Producto "1" <-- "0..*" DetalleRecepcion : recibido
Recepcion "0..1" <-- "0..*" MovimientoInventario : origen de ingreso
Producto "1" *-- "0..*" Lote : identifica partidas
Lote "0..1" <-- "0..*" MovimientoInventario : trazado por lote

Usuario "0..1" <-- "0..*" Venta : registrado por
Usuario "0..1" <-- "0..*" MovimientoInventario : registrado por
Usuario "0..1" <-- "0..*" Recepcion : registrado por
@enduml
